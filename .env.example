# Node.js 24 oder neuer. Ohne .env gelten diese Standardwerte.
# Im öffentlichen Betrieb die folgende Zeile aktivieren.
# NODE_ENV=production
HOST=127.0.0.1
PORT=3001
# Relativ zum Projektverzeichnis oder als absoluter Pfad.
DATABASE_PATH=./data/8a.sqlite

# Aufräumen und Speicherquoten. In Konten gespeicherte Projekte werden nicht automatisch gelöscht.
WORKSPACE_RETENTION_DAYS=180
TRAFFIC_RETENTION_HOURS=48
MAX_USERS=5000
MAX_WORKSPACES=5000
MAX_WORKSPACES_PER_ACCOUNT=100
MAX_TRAFFIC_ROOMS=500

# Großzügig genug für mindestens 30 Geräte hinter derselben Schul-IP.
API_RATE_LIMIT=1500
WRITE_RATE_LIMIT=360
LOGIN_IP_RATE_LIMIT=120
LOGIN_ACCOUNT_RATE_LIMIT=10
REGISTER_RATE_LIMIT=60
WORKSPACE_CREATE_RATE_LIMIT=120
TRAFFIC_CREATE_RATE_LIMIT=60
TRAFFIC_JOIN_RATE_LIMIT=240
IDEA_RATE_LIMIT=20
